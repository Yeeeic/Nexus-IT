# Copy this file to .env and replace every placeholder locally.
# Never commit the resulting .env file.
NEXUS_ENV=development
NEXUS_API_PORT=8000
NEXUS_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
NEXUS_ACTION_PRIVATE_KEY=
NEXUS_ACTION_KEY_VERSION=1
NEXUS_POSTGRES_DB=nexus_it
NEXUS_POSTGRES_USER=nexus_bootstrap
NEXUS_POSTGRES_PASSWORD=replace-with-a-random-local-password
NEXUS_RUNTIME_POSTGRES_PASSWORD=replace-with-an-independent-runtime-password
NEXUS_MAINTENANCE_POSTGRES_PASSWORD=replace-with-an-independent-maintenance-password
NEXUS_REDIS_PASSWORD=replace-with-a-different-random-local-password
NEXUS_SERVER_PEPPER=replace-with-at-least-32-random-characters
NEXUS_SMTP_HOST=smtp.example.com
NEXUS_SMTP_PORT=587
NEXUS_SMTP_USERNAME=nexus@example.com
NEXUS_SMTP_PASSWORD=replace-with-an-independent-smtp-password
NEXUS_SMTP_FROM=nexus@example.com
NEXUS_PASSWORD_RESET_URL=http://127.0.0.1:8080/reset-password
NEXUS_ATTACHMENTS_ROOT=/var/lib/nexus/attachments
# Local bootstrap only; never commit real values.
NEXUS_SEED_ADMIN_EMAIL=admin@localhost
NEXUS_SEED_ADMIN_PASSWORD=replace-with-a-random-local-password
